 "The functions below can be used to empirically verify the 10-dissections of \
Lemma 3.1 up to a given order of ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af8fc5e9-7cae-4984-92c6-c79875ce09bb"],
 ". Below we verify that formulae (3.10)\[LongDash](3.13) are correct up to \
(at least) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "5000"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "36e8b013-cede-47fd-851d-35c7d2df48c6"],
 "."
}], "Text",ExpressionUUID->"a04cf48c-e360-48d5-8ed3-b717d48c5eb7"],

Cell[BoxData[""], "Input",ExpressionUUID->"1a75acad-4234-406f-9ef8-e1195e0a8e4d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QP", "::", "usage"}], " ", "=", " ", 
    "\"\<Gives (\!\(\*SubscriptBox[\(z\), \(1\)]\);q\!\(\*SubscriptBox[\()\), \
\(\[Infinity]\)]\)(\!\(\*SubscriptBox[\(z\), \(2\)]\);q\!\(\*SubscriptBox[\()\
\), \(\[Infinity]\)]\)\[CenterEllipsis](\!\(\*SubscriptBox[\(z\), \
\(k\)]\);q\!\(\*SubscriptBox[\()\), \(\[Infinity]\)]\) for \
\!\(\*SubscriptBox[\(z\), \(i\)]\) \[Element] zList.\>\""}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "following", " ", "definition", " ", "allows", " ", "for", 
     " ", "one", " ", "to", " ", "write"}], ",", " ", 
    RowBox[{"for", " ", "example"}], ",", " ", 
    RowBox[{
     RowBox[{"QP", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", 
         SuperscriptBox["q", "2"], ",", 
         SuperscriptBox["q", "4"]}], "}"}], ",", 
       SuperscriptBox["q", "5"]}], "]"}], " ", "for", " ", 
     RowBox[{"QP", "[", 
      RowBox[{"q", ",", 
       SuperscriptBox["q", "5"]}], "]"}], 
     RowBox[{"QP", "[", 
      RowBox[{
       SuperscriptBox["q", "2"], ",", 
       SuperscriptBox["q", "5"]}], "]"}], 
     RowBox[{"QP", "[", 
      RowBox[{
       SuperscriptBox["q", "4"], ",", 
       SuperscriptBox["q", "5"]}], "]"}], " ", "in", " ", "place", " ", "of", 
     " ", "writing", " ", "out", " ", "QPochhammer", " ", "multiple", " ", 
     RowBox[{"times", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QP", "[", 
    RowBox[{"zList_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"QPochhammer", "[", 
      RowBox[{"x", ",", "q"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "zList"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"5547013c-2712-43df-a327-a99cf85be6d4"],

