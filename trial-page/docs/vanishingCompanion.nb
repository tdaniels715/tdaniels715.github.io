Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"m_", ",", "n_", ",", "1"}], "}"}], "}"}], "]"}], ":=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"5", 
      SuperscriptBox["m", "2"]}], "+", "m", "+", 
