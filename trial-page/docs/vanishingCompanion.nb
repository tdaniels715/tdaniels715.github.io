Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Use", " ", "this", " ", "to", " ", "determine", " ", "the", " ", 
    SubscriptBox["v", "r"], " ", "for", " ", "below"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"m0", "=", "4"}], ";", 
    RowBox[{"n0", "=", "4"}], ";", 
    RowBox[{"mOr", "=", 
     RowBox[{"m0", "+", "1"}]}], ";", 
    RowBox[{"nOr", "=", 
     RowBox[{"n0", "+", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", " ", "=", " ", 
     RowBox[{"Reverse", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"(", GridBox[{
             {"m", "n", "1"}
            }], ")"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "m0"}], ",", "m0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"-", "n0"}], ",", "n0"}], "}"}]}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"T", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x_", "/;", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"x", ",", "10"}], "]"}], "==", "s"}]}], "->", 
         RowBox[{"Style", "[", 
          RowBox[{"x", ",", "Blue", ",", "Bold"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"x_", "/;", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"x", ",", "10"}], "]"}], "==", 
           RowBox[{"s", "+", "5"}]}]}], "->", 
         RowBox[{"Style", "[", 
          RowBox[{"x", ",", "Red", ",", "Bold"}], "]"}]}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Dividers", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mOr", "->", "Black"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"nOr", "->", "Black"}], "}"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"0882af23-1371-458a-926d-\
b88936ef8fdc"],

