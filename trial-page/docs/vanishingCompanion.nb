     RowBox[{"m0", "+", "1"}]}], ";", 
    RowBox[{"nOr", "=", 
     RowBox[{"n0", "+", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", " ", "=", " ", 
     RowBox[{"Reverse", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"(", GridBox[{
             {"m", "n", "1"}
            }], ")"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "m0"}], ",", "m0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"-", "n0"}], ",", "n0"}], "}"}]}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"T", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x_", "/;", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"x", ",", "10"}], "]"}], "==", "s"}]}], "->", 
         RowBox[{"Style", "[", 
          RowBox[{"x", ",", "Blue", ",", "Bold"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"x_", "/;", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"x", ",", "10"}], "]"}], "==", 
           RowBox[{"s", "+", "5"}]}]}], "->", 
         RowBox[{"Style", "[", 
          RowBox[{"x", ",", "Red", ",", "Bold"}], "]"}]}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Dividers", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mOr", "->", "Black"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"nOr", "->", "Black"}], "}"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",ExpressionUUID->"bf9aca69-6f5f-4e1f-9a84-\
639172034a4c"],

