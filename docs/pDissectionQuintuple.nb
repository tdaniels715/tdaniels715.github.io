5e0f4540c48c"],

Cell[TextData[{
 "Equation (3.6) states that\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["A", "3"], " ", "==", " ", 
    RowBox[{"\[Xi]", "+", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[CapitalNu]", "(", 
        RowBox[{"\[Beta]", "-", "y"}], ")"}], "-", 
       SubscriptBox["\[Sigma]", "\[CapitalNu]"]}], ")"}], "+", 
