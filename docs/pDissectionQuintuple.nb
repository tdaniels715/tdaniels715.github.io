b3fda6229839"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Q", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["q", "l"], ",", 
       SuperscriptBox["q", "p"]}], ")"}]}], " ", ":=", " ", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["q", "l"], ",", 
        SuperscriptBox["q", 
         RowBox[{"p", "-", "l"}]], ",", 
        RowBox[{
         SuperscriptBox["q", "p"], ";", 
         SuperscriptBox["q", "p"]}]}], ")"}], "\[Infinity]"], 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["q", 
         RowBox[{"p", "-", 
          RowBox[{"2", "l"}]}]], ",", 
        RowBox[{
         SuperscriptBox["q", 
          RowBox[{"p", "+", 
           RowBox[{"2", "l"}]}]], ";", 
         SuperscriptBox["q", 
          RowBox[{"2", "p"}]]}]}], ")"}], "\[Infinity]"]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
