 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Expand", " ", "and", " ", "replace", " ", "y"}], "\[Rule]", 
    RowBox[{"3", 
     SuperscriptBox["p", "2"]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
