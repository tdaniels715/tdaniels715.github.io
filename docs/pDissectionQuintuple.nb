       RowBox[{"3", "m", " ", "\[Mu]"}], ",", "\[DoubleStruckOne]"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{"\[DoubleStruckOne]", "->", 
       RowBox[{"1", "+", 
        RowBox[{"p", " ", "s"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Definition", " ", "of", " ", 
    SubscriptBox["\[Delta]", "0"]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Expand", " ", Cell[TextData[Cell[BoxData[
      RowBox[{"bn", "+", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"\[Kappa]", "-", "n\[Mu]"}]], "-", 
