Cell[TextData[{
 "To check that \n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["q", 
      SubscriptBox["\[Gamma]", 
       RowBox[{"k", "-", "p"}]]], 
     SubscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["q", 
          RowBox[{
           SubscriptBox["\[Alpha]", "k"], "-", 
           RowBox[{"m", "\[VeryThinSpace]", "y"}]}]]}], ",", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["q", 
           RowBox[{
            SubscriptBox["\[Beta]", "k"], "-", 
            RowBox[{"n", "\[VeryThinSpace]", "y"}]}]]}], ";", 
         SuperscriptBox["q", "y"]}]}], "\[RightAngleBracket]"}], 
      "\[Infinity]"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["q", 
       RowBox[{
        SubscriptBox["\[Gamma]", 
         RowBox[{"k", "-", "p"}]], "+", 
        RowBox[{"m", "(", 
         RowBox[{
          SubscriptBox["\[Alpha]", "k"], "-", "y"}], ")"}], "-", 
        SubscriptBox["\[Sigma]", "m"], "+", 
        RowBox[{"n", "(", 
         RowBox[{
          SubscriptBox["\[Beta]", "k"], "-", "y"}], ")"}], "-", 
        SubscriptBox["\[Sigma]", "n"]}]], 
      SubscriptBox[
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["q", 
           SubscriptBox["\[Alpha]", "k"]]}], ",", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["q", 
            SubscriptBox["\[Beta]", "k"]]}], ";", 
          SuperscriptBox["q", "y"]}]}], "\[RightAngleBracket]"}], 
       "\[Infinity]"]}], "=", 
     RowBox[{
      SuperscriptBox["q", 
       SubscriptBox["\[Gamma]", "k"]], 
      SubscriptBox[
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["q", 
           SubscriptBox["\[Alpha]", "k"]]}], ",", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["q", 
            SubscriptBox["\[Beta]", "k"]]}], ";", 
          SuperscriptBox["q", "y"]}]}], "\[RightAngleBracket]"}], 
       "\[Infinity]"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb023c26-061c-4631-957c-4294fd751419"]
}], "Text",
 CellChangeTimes->{{3.981306462464471*^9, 
  3.9813066327248163`*^9}},ExpressionUUID->"dced8abc-3103-499e-bf23-\
99438a189868"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p", "==", 
     RowBox[{
      SuperscriptBox["m", "2"], "+", 
      SuperscriptBox["n", "2"]}]}], "}"}], ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Gamma]", "[", 
        RowBox[{"k", "-", "p"}], "]"}], "-", 
       RowBox[{"\[Gamma]", "[", "k", "]"}], "+", 
       RowBox[{"m", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Alpha]", "[", "k", "]"}], "-", "y"}], ")"}]}], "-", 
       RowBox[{"\[Sigma]", "[", "m", "]"}], "+", 
       RowBox[{"n", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Beta]", "[", "k", "]"}], "-", "y"}], ")"}]}], "-", 
       RowBox[{"\[Sigma]", "[", "n", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"y", "->", 
        RowBox[{"3", 
         SuperscriptBox["p", "2"]}]}], "}"}]}], "//", "Expand"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9813066418202553`*^9, 3.9813067093788357`*^9}},
 CellLabel->
