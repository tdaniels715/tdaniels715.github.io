Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"X", "=", 
   RowBox[{
    RowBox[{"QP", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["q", "2"], ",", 
        SuperscriptBox["q", "4"], ",", 
        SuperscriptBox["q", "9"], ",", 
        SuperscriptBox["q", "11"], ",", 
        SuperscriptBox["q", "13"], ",", 
        SuperscriptBox["q", "13"]}], "}"}], ",", 
      SuperscriptBox["q", "13"]}], "]"}], "*", 
    RowBox[{"QP", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["q", "5"], ",", 
        SuperscriptBox["q", "9"], ",", 
        SuperscriptBox["q", "17"], ",", 
        SuperscriptBox["q", "21"]}], "}"}], ",", 
      SuperscriptBox["q", "26"]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"X", "//", "TraditionalForm"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"QPPowerList", "[", "X", "]"}], ",", 
   RowBox[{"TableDepth", "->", "2"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9796824143090963`*^9, 3.979682476688367*^9}, {
   3.979682525031289*^9, 3.979682534160996*^9}, 3.980874630871819*^9},
 CellLabel->"In[65]:=",ExpressionUUID->"eba69f65-d93e-44cd-b743-4c52a59b57e9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{
     SuperscriptBox["q", "2"], 
     SuperscriptBox["q", "13"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "4"], 
     SuperscriptBox["q", "13"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "5"], 
     SuperscriptBox["q", "26"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "9"], 
     SuperscriptBox["q", "13"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "9"], 
     SuperscriptBox["q", "26"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "11"], 
     SuperscriptBox["q", "13"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "17"], 
     SuperscriptBox["q", "26"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "21"], 
     SuperscriptBox["q", "26"]},
    "QPochhammer2"], " ", 
   TemplateBox[{
     SuperscriptBox["q", "13"], 
     SuperscriptBox["q", "13"], "2"},
    "QPochhammerPower2"]}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.979682469561064*^9, 3.979682477233392*^9}, 
   3.979682537219668*^9, 3.980874643383566*^9},
