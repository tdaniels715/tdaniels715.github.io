     "3m\[Mu]\[Rule]1+ps",ExpressionUUID->
      "4c3a9998-f969-4a6a-8aec-47a23e1564b0"]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["\[Delta]", "0"], "=", 
  RowBox[{
   RowBox[{"\[Mu]Reduce", "[", 
