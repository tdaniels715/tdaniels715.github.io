Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["n", "2"], "-", "p"}], ")"}], " ", 
    SuperscriptBox["p", "2"], " ", "s", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"p", " ", "s"}]}], ")"}]}], 
   RowBox[{"6", " ", 
    SuperscriptBox["m", "2"]}]]}]], "Output",
 CellChangeTimes->{{3.97984009232753*^9, 3.9798401326089077`*^9}, {
   3.97984017334978*^9, 3.979840199920108*^9}, {3.979840283290502*^9, 
   3.9798403071822157`*^9}, 3.97984041176581*^9, {3.981302049163137*^9, 
