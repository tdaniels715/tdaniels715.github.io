 CellLabel->"Out[32]=",ExpressionUUID->"60b9c0c3-7d66-426b-9a4b-526c27114de3"]
}, Open  ]],

Cell[TextData[{
 "As ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "2"], "-", "p"}], "=", 
    RowBox[{"-", 
     SuperscriptBox["m", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a128170d-129e-4591-abe3-fac47766e307"],
 ", we see that indeed\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Delta]", "0"], "+", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Mu]", "(", 
        RowBox[{"\[Beta]", "+", 
         RowBox[{"m", "\[VeryThinSpace]", "s", "\[VeryThinSpace]", 
          SuperscriptBox["p", "2"]}], "-", "y"}], ")"}], "-", 
       SubscriptBox["\[Sigma]", "\[Mu]"]}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", "b"}], "\[VeryThinSpace]", "n", "\[VeryThinSpace]", "p", "\[VeryThinSpace]",
        "s"}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"p", "\[VeryThinSpace]", "s"}]}], ")"}], 
        SuperscriptBox["p", "2"], "s"}], "6"]}], "=", "\[Delta]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7184c5fa-a43e-4efc-9b56-f1b05dfe7306"],
 ",\nwhich verifies equation (2.14)."
}], "Text",
 CellChangeTimes->{{3.981302072858252*^9, 
  3.9813021513358393`*^9}},ExpressionUUID->"606ec46b-c26c-4ab7-a15d-\
