Cell[CellGroupData[{

Cell["Pochhammer Symbol", "Subsection",
 CellChangeTimes->{{3.979225852635441*^9, 
  3.979225859760219*^9}},ExpressionUUID->"40142dbd-234d-4cd1-8457-\
c128363f5937"],

Cell[TextData[{
 "We use `QP` as an abbreviation for the function `QPochhammer`. Defining \
this \[OpenCurlyDoubleQuote]new\[CloseCurlyDoubleQuote] `QP` allows us to \
accept lists as inputs. For example,\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"QP", "[", 
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}]], ",", "q"}], "]"}], TraditionalForm]],
  ExpressionUUID->"710e01c3-18ad-40d4-b2c8-5fb6eda0c99f"],
 ",\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"QP", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["z", "a"], ",", 
       SuperscriptBox["z", "b"]}], "}"}], ",", "q"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"86198918-1a7f-4024-b366-053a8b46643b"],
 ",\t     and \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"QP", "[", 
     RowBox[{
      SuperscriptBox["z", "a"], ",", "q"}], "]"}], 
    RowBox[{"QP", "[", 
     RowBox[{
      SuperscriptBox["z", "b"], ",", "q"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"4f889257-bcd6-4598-9893-dd98aaf13c78"],
 "\nare equivalent in our code."
}], "Text",
 CellChangeTimes->{{3.980863582051105*^9, 3.980863706776602*^9}, {
   3.980863835161553*^9, 3.9808638894136257`*^9}, 3.980873038467506*^9, {
   3.9809741246695423`*^9, 
   3.980974143228381*^9}},ExpressionUUID->"8110f508-4c51-4480-8683-\
1cd618720125"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"QP", "[", 
    RowBox[{"z_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"QPochhammer", "[", 
    RowBox[{"z", ",", "q"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"QP", "[", 
     RowBox[{
      RowBox[{"Z_", "?", "ListQ"}], ",", "q_"}], "]"}], ":=", 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{"QPochhammer", "[", 
       RowBox[{"z", ",", "q"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "Z"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"z", ";", "q"}], ")"}], "h"], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["QP", "h_"], "[", 
     RowBox[{"z_", ",", "q_"}], "]"}], ":=", 
    RowBox[{
     UnderoverscriptBox["\[Product]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{"h", "-", "1"}]], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"z", "*", 
        SuperscriptBox["q", "k"]}]}], ")"}]}]}], ";"}], " ", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "a", " ", "list", " ", "of", " ", "powers", " ", "and", " ",
     "moduli", " ", "from", " ", "a", " ", "product", " ", "of", " ", "QPs"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QPPowerList", "[", 
    RowBox[{"Times", "[", "X__", "]"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"XL", ",", "powL"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"XL", "=", 
       RowBox[{"List", "@@", "X"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "Return", " ", "list", " ", "of", " ", "things", " ", "multiplied"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"XL", "=", 
       RowBox[{"XL", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Power", "[", 
           RowBox[{
            RowBox[{"QPochhammer", "[", 
             RowBox[{"x_", ",", "y_"}], "]"}], ",", "e_"}], "]"}], ":>", 
          RowBox[{"Splice", "[", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"QPochhammer", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "e"}], "]"}], "]"}]}], 
         "}"}]}]}], 
      RowBox[{"(*", 
       RowBox[{"Split", " ", "apart", " ", "powers"}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"powL", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"XL", ",", 
         RowBox[{
          RowBox[{"QPochhammer", "[", 
           RowBox[{
            SuperscriptBox["q", "x_"], ",", 
            SuperscriptBox["q", "y_"]}], "]"}], "->", 
          RowBox[{"{", 
           RowBox[{"y", ",", "x"}], "}"}]}]}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{"List", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"mod", ",", "expon"}], "}"}]}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"powL", "=", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"powL", ",", 
         RowBox[{"First", "->", "Last"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Flatten", "[", "#2", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"{", "#1", "}"}], "}"}]}], "}"}], "&"}], ",", "powL"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979225865923695*^9, 3.979225936429914*^9}, {
  3.9792260991709547`*^9, 3.9792262559333477`*^9}, {3.979226371059845*^9, 
  3.979226686581871*^9}, {3.979226728198534*^9, 3.979226792367893*^9}, {
  3.979226857482254*^9, 3.979226867573454*^9}, {3.979226923074212*^9, 
  3.9792270084145603`*^9}, {3.979227114572611*^9, 3.9792274296350527`*^9}, {
  3.979229152047447*^9, 3.9792292173831587`*^9}, {3.9792297227554417`*^9, 
  3.9792297254756308`*^9}, {3.979229924928529*^9, 3.97922999885644*^9}, {
  3.979682366120923*^9, 3.9796823675280447`*^9}, {3.979682410702993*^9, 
  3.979682411661545*^9}, {3.9808639006839237`*^9, 3.980863901372774*^9}, {
  3.980864527562726*^9, 3.980864544972649*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"b725d99f-4975-4085-913a-03f5f04ca802"],

