Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39da6b29-e048-4b2d-9484-de4b35e05196"],
 "-Dissection of a product of quintuple products"
}], "Title",
 CellChangeTimes->{{3.9814680912774343`*^9, 3.98146810189437*^9}, {
  3.9814681548318567`*^9, 
  3.9814681562103577`*^9}},ExpressionUUID->"865a1abc-f462-450a-9014-\
1d7b0563c878"],

Cell["T. Daniels, T. Huber, J. McLaughin, D. Ye", "Subtitle",
 CellChangeTimes->{{3.981468388498672*^9, 
  3.981468406349019*^9}},ExpressionUUID->"a80499c5-5afe-4ca4-a4ec-\
9a6b63b7f7c9"],

Cell[TextData[{
 "This notebook is intended as a helpful tool in documenting and verifying \
some formulas and computations in the paper \[OpenCurlyDoubleQuote]The ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3be1ce6a-17f1-4f70-82d1-cf4f99f94657"],
 "-Dissection of a product of quintuple products\[CloseCurlyDoubleQuote], as \
well as providing tools for computing explicit examples."
}], "Abstract",
 CellChangeTimes->{{3.981468244335202*^9, 
  3.981468382184473*^9}},ExpressionUUID->"bd80fcff-39f4-45fe-814a-\
bad1c9b79e3b"],

Cell[CellGroupData[{

Cell["Definitions", "Section",
 CellChangeTimes->{{3.979225847193995*^9, 
  3.9792258480868273`*^9}},ExpressionUUID->"6fe21cf8-983d-492e-a13b-\
64f16ec5e2e8"],

Cell[CellGroupData[{

Cell["Documentation/README", "Subsection",
 CellChangeTimes->{{3.980862937100932*^9, 
  3.980862951724532*^9}},ExpressionUUID->"d9198039-7c75-446e-8827-\
5089a6e3e8d3"],

Cell["\<\
This notebook uses a fair amount of \[OpenCurlyDoubleQuote]special characters\
\[CloseCurlyQuote]\[CloseCurlyQuote] and symbolic notation/definitions, so we \
want to briefly explain the usage/practices found herein\
\>", "Text",
 CellChangeTimes->{{3.980862959704055*^9, 3.9808629884173927`*^9}, {
  3.980863021774778*^9, 
  3.980863057879362*^9}},ExpressionUUID->"c4d5691c-dcaf-4752-8568-\
ed15b8915e2b"],

Cell[TextData[{
 "Greek letters are entered using the pattern ",
 Cell[BoxData[
  FormBox["\[EscapeKey]letter\[EscapeKey]", TraditionalForm]],ExpressionUUID->
  "ef06b75a-6132-4edf-ab90-48abfbc3f6a6"],
 ", for example\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[EscapeKey]g\[EscapeKey]", " ", "->", " ", "\[Gamma]"}], 
   TraditionalForm]],ExpressionUUID->"79cd116a-770e-4c59-8883-92c9a0e98fd8"],
 ",\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[EscapeKey]G\[EscapeKey]", " ", "->", " ", 
    RowBox[{"\[CapitalGamma]", "."}]}], TraditionalForm]],ExpressionUUID->
  "abbd808c-9337-4792-839b-41b5a25bcb6c"],
 " "
}], "ItemNumbered",
 CellChangeTimes->{{3.9808633780083437`*^9, 
  3.980863384622992*^9}},ExpressionUUID->"96ec0cdc-bee4-42a8-b9ec-\
d0d90491d953"],

Cell[TextData[{
 "Because \[OpenCurlyDoubleQuote]primed\[CloseCurlyDoubleQuote] inputs like \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "'"}], TraditionalForm]],ExpressionUUID->
  "295689c2-075c-4069-942e-92e5a6b1c7f7"],
 " do not work as variables, below we define the quote character \
\[CloseCurlyQuote] as a symbol, so that expressions like ",
 Cell[BoxData[
  FormBox["h\:02bc", TraditionalForm]],ExpressionUUID->
  "36a6381a-5eb6-41bc-ab8e-d48bde198ee0"],
 " do function as \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "8320487a-8fef-4917-9465-428007662060"],
 " prime\[CloseCurlyDoubleQuote]. This character is entered using\
\[LineSeparator]\t",
 Cell[BoxData[
  FormBox["\[EscapeKey]aff\[EscapeKey]", TraditionalForm]],ExpressionUUID->
  "518ab30e-d913-4048-9518-acbaeb7db09f"],
 "\[LineSeparator](we previously used it to mean \
\[OpenCurlyDoubleQuote]affine\[CloseCurlyDoubleQuote]). "
}], "ItemNumbered",
 CellChangeTimes->{{3.9808633960406113`*^9, 3.9808635147773857`*^9}, {
  3.980974055089843*^9, 
  3.980974056377843*^9}},ExpressionUUID->"8a68405a-a49f-4a82-b658-\
958b2c11c917"],

Cell[TextData[{
 "Many of our expressions use ",
 Cell[BoxData[
  FormBox["\[ControlKey]6", TraditionalForm]],ExpressionUUID->
  "b9146a8f-6710-4a78-8c08-4ac7a8184b04"],
 " to place exponents, e.g.,  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "6"], TraditionalForm]],ExpressionUUID->
  "87200874-bb2a-4ec2-9c68-c81ae9e7bc39"],
 " vs. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "^", "6"}], TraditionalForm]],ExpressionUUID->
  "510ab957-6749-4f2d-be4b-2dcdaf022b4e"],
 ". These inputs are equivalent, and our code works equally well with both. "
}], "ItemNumbered",
 CellChangeTimes->{
  3.9808633960406113`*^9, {3.980863711936153*^9, 3.980863804560132*^9}, {
   3.9808639184243383`*^9, 3.980864002441243*^9}, {3.980872959577105*^9, 
   3.980872993585596*^9}, {3.980876911813555*^9, 3.980876911818462*^9}, {
   3.980974078634862*^9, 
   3.980974082798222*^9}},ExpressionUUID->"119593a3-481f-4e79-a538-\
7dc4e91886bb"],

Cell[CellGroupData[{

Cell[TextData[{
 "Similarly, for some expressions we use ",
 Cell[BoxData[
  FormBox["\[ControlKey]_", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ec33d94-e282-4c6d-a3e9-c6d46b102752"],
 " to place subscripts. The inputs\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86e54d6b-0977-4a70-855e-1a4202583e52"],
 "\tand \t",
 Cell[BoxData[
  FormBox[
   RowBox[{"Subscript", "[", 
    RowBox[{"x", ",", "k"}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a678a079-e671-4fd1-b86c-8c90faf0164b"],
 "\[LineSeparator]are equivalent."
}], "ItemNumbered",
 CellChangeTimes->{
  3.9808633960406113`*^9, {3.980863711936153*^9, 3.980863804560132*^9}, {
   3.9808639184243383`*^9, 3.980864002441243*^9}, {3.980872959577105*^9, 
   3.980872993585596*^9}},ExpressionUUID->"cae8e672-656e-422a-81b9-\
21087e9c6e9b"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "Expand", " ", "the", " ", "sections", " ", "below", " ", "and", " ", "run",
    " ", "the", " ", "cells", " ", "to", " ", "set", " ", "definitions"}], 
  "*)"}]], "Input",ExpressionUUID->"a40d0a29-37e7-4cbc-a018-fdde37578418"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Misc", "Subsection",
 CellChangeTimes->{{3.979229740504448*^9, 
  3.979229741091827*^9}},ExpressionUUID->"ef81a3dd-3d1c-428b-880e-\
533ed6c245eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Cancels", " ", "instances", " ", "of", " ", Cell[TextData[Cell[BoxData[
     FormBox[
      RowBox[{"x", 
       OverscriptBox["x", "_"]}], TraditionalForm]],ExpressionUUID->
     "3282639d-290d-47b8-99b3-d76ea9f18850"]],ExpressionUUID->
     "f2205574-7018-481b-845e-fa78adf27b41"], " ", 
    RowBox[{"(", 
     RowBox[{"to", " ", "1"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AR", "=", 
     RowBox[{"ResourceFunction", "[", "\"\<AlgebraicReplace\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cancelInv", "[", 
      RowBox[{"expr_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"AR", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"expr", "*", "x", "*", 
            RowBox[{"OverBar", "[", "x", "]"}]}], "//", "Expand"}], ")"}], ",", 
         RowBox[{"x", " ", 
          RowBox[{"OverBar", "[", "x", "]"}]}], ",", "\[DoubleStruckOne]"}], 
        "]"}], ")"}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[DoubleStruckOne]", "->", "1"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Declaring", " ", "that", " ", "\[EscapeKey]aff\[EscapeKey]", " ", 
     "produces", " ", "the", " ", "\:02bc", " ", 
     RowBox[{"character", ".", " ", "This"}], " ", "allows", " ", "one", " ", 
     "to", " ", "use", " ", "things", " ", "like", " ", "h\:02bc", " ", "as", 
     " ", "variable", " ", "names"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"SetOptions", "[", 
    RowBox[{
     RowBox[{"EvaluationNotebook", "[", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"InputAliases", "->", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{"\"\<aff\>\"", "->", 
           RowBox[{"FromCharacterCode", "[", "700", "]"}]}], "|>"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"InputAliases", "/.", " ", 
          RowBox[{"Options", "[", 
           RowBox[{
            RowBox[{"EvaluationNotebook", "[", "]"}], ",", "InputAliases"}], 
           "]"}]}]}], "\[IndentingNewLine]", "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.979229759385776*^9, 3.979229760496999*^9}, {
  3.979839143106722*^9, 3.979839231156445*^9}, {3.980791010187117*^9, 
