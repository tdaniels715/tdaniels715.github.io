Cell[CellGroupData[{

Cell["Theorem 4, equation (3.6) ", "Subsection",
 CellChangeTimes->{{3.979840677981962*^9, 3.979840679522344*^9}, {
   3.981300007415518*^9, 3.981300008592346*^9}, {3.9813000391198*^9, 
