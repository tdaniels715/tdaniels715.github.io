Cell[TextData[{
 "For equation (2.14), we know that\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"\[Gamma]", "+", 
       SubscriptBox["\[Delta]", "0"]}]], 
     SubscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["q", 
          RowBox[{"\[Beta]", "+", 
           RowBox[{"m", "\[VeryThinSpace]", "s", "\[VeryThinSpace]", 
            SuperscriptBox["p", "2"]}], "-", 
           RowBox[{"\[Mu]", "\[VeryThinSpace]", "y"}]}]]}], ";", 
        SuperscriptBox["q", "y"]}], "\[RightAngleBracket]"}], 
      "\[Infinity]"]}], "=", " ", 
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"\[Gamma]", "+", 
       SubscriptBox["\[Delta]", "0"], "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Mu]", "(", 
          RowBox[{"\[Beta]", "+", 
           RowBox[{"m", "\[VeryThinSpace]", "s", "\[VeryThinSpace]", 
            SuperscriptBox["p", "2"]}], "-", "y"}], ")"}], "-", 
         SubscriptBox["\[Sigma]", "\[Mu]"]}], ")"}]}]], 
     SubscriptBox[
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["q", 
          RowBox[{"\[Beta]", "+", 
           RowBox[{"m", "\[VeryThinSpace]", "s", "\[VeryThinSpace]", 
            SuperscriptBox["p", "2"]}]}]]}], ";", 
        SuperscriptBox["q", "y"]}], "\[RightAngleBracket]"}], 
      "\[Infinity]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38607dd3-259c-433d-b83a-c8f8bf65fac1"],
 ",\nso we want to simplify\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]", "0"], "+", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Mu]", "(", 
       RowBox[{"\[Beta]", "+", 
        RowBox[{"m", "\[VeryThinSpace]", "s", "\[VeryThinSpace]", 
         SuperscriptBox["p", "2"]}], "-", "y"}], ")"}], "-", 
      SubscriptBox["\[Sigma]", "\[Mu]"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5496ee6b-8620-4d9d-bb71-effbf186cc46"],
 "."
}], "Text",
 CellChangeTimes->{{3.981301670943458*^9, 3.981301768095584*^9}, {
  3.981301798864609*^9, 3.9813019252797003`*^9}, {3.98130195988538*^9, 
  3.981301964388459*^9}},ExpressionUUID->"41a09d5d-06d0-4fe5-acba-\
fc2620977735"],

