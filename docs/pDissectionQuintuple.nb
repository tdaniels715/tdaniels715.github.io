      RowBox[{"\[Mu]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "\[Kappa]", "]"}], "+", 
         RowBox[{"m", " ", "s", " ", 
          SuperscriptBox["p", "2"]}], "-", "y"}], ")"}]}], "-", 
      RowBox[{"\[Sigma]", "[", "\[Mu]", "]"}]}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{"y", "->", 
      RowBox[{"3", 
       SuperscriptBox["p", "2"]}]}], "}"}]}], "//", "Expand"}]}]], "Input",
