Cell[TextData[{
 "The expression\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SuperscriptBox["q", "a"], ";", 
      SuperscriptBox["q", "b"]}], "\[RightAngleBracket]"}], "\[Infinity]"], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3de6f0ba-fb99-49a2-a768-fd6910484612"],
 "\nis encoded for us via the input\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SuperscriptBox["q", "a"], ",", 
     SuperscriptBox["q", "b"]}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ddc33369-ed4d-444d-a948-cd1b693cfb51"],
 " .\nThe brackets are entered using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[EscapeKey]", "<", "\[EscapeKey]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "758467b0-3ce3-4b4b-b5eb-7d67482ebc9a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[EscapeKey]", ">", "\[EscapeKey]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2264c2e-c30a-41e4-9195-112a91982980"],
 ". Make sure to use a comma in the input, not a semicolon."
}], "Text",
 CellChangeTimes->{{3.980864754612352*^9, 
  3.9808648945193977`*^9}},ExpressionUUID->"4f4663c9-9ed2-41d6-8be5-\
554b386db5e6"],

Cell[TextData[{
 StyleBox["Note:",
  FontWeight->"Bold"],
 " The expressions of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l_", ":", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "33d04b16-d0e5-41dc-813e-8cbdc76e1a4c"],
 ", etc. indicate that ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b438ff1-39b6-497c-8add-ba6312791000"],
 " is an optional argument, and that `1` should be used if none is given. \
This lets us circumvent a \[OpenCurlyDoubleQuote]troublesome\
\[CloseCurlyDoubleQuote] case: if we defined only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SuperscriptBox["q", "l_"], ",", 
     SuperscriptBox["q", "M_"]}], "\[RightAngleBracket]"}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "374b64aa-6e36-453c-986f-70ff06423740"],
 ", the input ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"q", ",", 
     SuperscriptBox["q", "3"]}], "\[RightAngleBracket]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c147247-b4e6-49c9-8e15-c64da0873c4e"],
 " is undefined, because Mathematica reads `",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "93afada7-7b81-4ff6-82f9-73aa56e10012"],
 "` as just `",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d6878c1-e424-45e7-98ec-3418f6d97caa"],
 "`, not as `",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dff39a29-2ef8-4d6f-a5af-b6ad562bc4d0"],
 "`."
}], "Text",
 CellChangeTimes->{{3.9808650312998953`*^9, 
  3.98086538458792*^9}},ExpressionUUID->"e8dfecdb-2e76-40e9-8268-\
42f3ab233c10"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"These", " ", "define", " ", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SuperscriptBox["q", "a"], ",", 
       SuperscriptBox["q", "b"]}], "\[RightAngleBracket]"}], " ", "in", " ", 
     "terms", " ", "of", " ", "q"}], "-", 
    RowBox[{"Pochammer", " ", 
     RowBox[{"symbols", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Part", " ", "of", " ", "the", " ", "definition", " ", "first", 
    " ", "\"\<reduces\>\"", " ", "these", " ", "expressions", " ", "as", " ", 
    "in", " ", "Lemma", " ", "1"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{"1", ",", "_"}], "\[RightAngleBracket]"}], ":=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SuperscriptBox["q", 
         RowBox[{"l_", ":", "1"}]], ",", 
        SuperscriptBox["q", 
         RowBox[{"M_", ":", "1"}]]}], "\[RightAngleBracket]"}], "/;", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M", ">", "0"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", "==", 
           RowBox[{"Mod", "[", 
            RowBox[{"l", ",", "M"}], "]"}]}], "||", 
          RowBox[{"M", "==", "1"}]}], ")"}]}], ")"}]}], ":=", 
     RowBox[{"QP", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["q", "l"], ",", 
         SuperscriptBox["q", 
          RowBox[{"M", "-", "l"}]], ",", 
         SuperscriptBox["q", "M"]}], "}"}], ",", 
       SuperscriptBox["q", "M"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        SuperscriptBox["q", 
         RowBox[{"l_", ":", "1"}]], ",", 
        SuperscriptBox["q", 
         RowBox[{"M_", ":", "1"}]]}], "\[RightAngleBracket]"}], "/;", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M", ">", "0"}], "&&", 
        RowBox[{"l", "!=", 
         RowBox[{"Mod", "[", 
          RowBox[{"l", ",", "M"}], "]"}]}]}], ")"}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"h", "=", 
          RowBox[{"\[LeftFloor]", 
           RowBox[{"l", "/", "M"}], "\[RightFloor]"}]}], ",", 
         RowBox[{"r", "=", 
          RowBox[{"Mod", "[", 
           RowBox[{"l", ",", "M"}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "h"], 
        SuperscriptBox["q", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "h"}], " ", "r"}], " ", "-", " ", 
          RowBox[{"h", 
           RowBox[{"(", 
            RowBox[{"h", "-", "1"}], ")"}], 
           RowBox[{"M", "/", "2"}]}]}]], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{
          SuperscriptBox["q", "r"], ",", 
          SuperscriptBox["q", "M"]}], "\[RightAngleBracket]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       SuperscriptBox["q", 
        RowBox[{"M_", ":", "1"}]]}], "\[RightAngleBracket]"}], ":=", 
     RowBox[{"QP", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", 
          SuperscriptBox["q", "M"]}], ",", 
         SuperscriptBox["q", "M"]}], "}"}], ",", 
       SuperscriptBox["q", "M"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["q", 
          RowBox[{"l_", ":", "1"}]]}], ",", 
        SuperscriptBox["q", 
         RowBox[{"M_", ":", "1"}]]}], "\[RightAngleBracket]"}], "/;", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M", ">", "0"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", "==", 
           RowBox[{"Mod", "[", 
            RowBox[{"l", ",", "M"}], "]"}]}], "||", 
          RowBox[{"M", "==", "1"}]}], ")"}]}], ")"}]}], ":=", 
     RowBox[{"QP", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["q", "l"]}], ",", 
         RowBox[{"-", 
          SuperscriptBox["q", 
           RowBox[{"M", "-", "l"}]]}], ",", 
         SuperscriptBox["q", "M"]}], "}"}], ",", 
       SuperscriptBox["q", "M"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["q", 
          RowBox[{"l_", ":", "1"}]]}], ",", 
        SuperscriptBox["q", 
         RowBox[{"M_", ":", "1"}]]}], "\[RightAngleBracket]"}], "/;", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"M", ">", "0"}], "&&", 
        RowBox[{"l", "!=", 
         RowBox[{"Mod", "[", 
          RowBox[{"l", ",", "M"}], "]"}]}]}], ")"}]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"h", "=", 
          RowBox[{"\[LeftFloor]", 
           RowBox[{"l", "/", "M"}], "\[RightFloor]"}]}], ",", 
         RowBox[{"r", "=", 
          RowBox[{"Mod", "[", 
           RowBox[{"l", ",", "M"}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        SuperscriptBox["q", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "h"}], " ", "r"}], " ", "-", " ", 
          RowBox[{"h", 
           RowBox[{"(", 
            RowBox[{"h", "-", "1"}], ")"}], 
           RowBox[{"M", "/", "2"}]}]}]], 
        RowBox[{"\[LeftAngleBracket]", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["q", "r"]}], ",", 
          SuperscriptBox["q", "M"]}], "\[RightAngleBracket]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.979229159586811*^9, 3.979229161645372*^9}, {
   3.979229242750476*^9, 3.9792292871609507`*^9}, {3.9792293194715548`*^9, 
   3.979229367475319*^9}, {3.979229447955669*^9, 3.979229507971533*^9}, {
   3.9792295607328568`*^9, 3.979229620647862*^9}, 3.979230712535652*^9, {
