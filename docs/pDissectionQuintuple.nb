Cell[CellGroupData[{

Cell[TextData[{
 "Exponent quantities ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d6585915-a509-4f21-807c-ccd16bc458b6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef298f72-2ef9-484b-aa51-e543fb62384e"],
 ", etc."
}], "Subsection",
 CellChangeTimes->{{3.979227485623665*^9, 3.979227488165001*^9}, {
