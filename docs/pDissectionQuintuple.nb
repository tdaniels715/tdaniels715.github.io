   3.979236713548998*^9}, {3.9792416681747437`*^9, 3.979241669101329*^9}, {
   3.979243298988822*^9, 3.979243364270702*^9}, {3.9792525108800697`*^9, 
   3.979252525799077*^9}, {3.979857881761722*^9, 3.9798579059372807`*^9}, {
   3.9799487413864822`*^9, 3.979948744401478*^9}, {3.980018726649209*^9, 
   3.9800187833886127`*^9}, {3.98001887499216*^9, 3.980018913977833*^9}, {
   3.980019020898265*^9, 3.980019040581161*^9}, {3.980019083047859*^9, 
   3.9800191430396023`*^9}, {3.980019470718954*^9, 3.980019504594385*^9}, {
