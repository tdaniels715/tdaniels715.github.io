Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "p", ",", "m", ",", "n", ",", "b", ",", "\[Mu]", ",", "s", ",", "y"}], 
   "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
