Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Simplify", " ", "the", " ", "latter", " ", "pieces"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", "==", 
      RowBox[{
       SuperscriptBox["m", "2"], "+", 
       SuperscriptBox["n", "2"]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"m", " ", "p", " ", "\[Mu]"}], "2"], "+", 
       RowBox[{"m", " ", 
        SuperscriptBox["p", "2"], " ", "s", " ", "\[Mu]"}], "+", 
       RowBox[{
        FractionBox["3", "2"], " ", 
        SuperscriptBox["n", "2"], " ", "p", " ", 
        SuperscriptBox["\[Mu]", "2"]}], "-", 
       FractionBox[
        RowBox[{"3", " ", 
         SuperscriptBox["p", "2"], " ", 
         SuperscriptBox["\[Mu]", "2"]}], "2"]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", "->", 
        FractionBox[
         RowBox[{"1", "+", 
          RowBox[{"p", " ", "s"}]}], 
         RowBox[{"3", "m"}]]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.979839876407649*^9, 3.9798399184884872`*^9}, {
  3.979840051490656*^9, 3.979840199206749*^9}, {3.979840281167379*^9, 
  3.979840399495043*^9}, {3.981302059583613*^9, 3.981302061293833*^9}},
