      RowBox[{"\[Kappa]", "-", 
       RowBox[{"n", " ", "\[Mu]"}]}], "]"}], "-", 
     RowBox[{"\[Gamma]", "[", "\[Kappa]", "]"}]}], "]"}], "//", 
   "Expand"}]}]}], "Input",
 CellChangeTimes->{{3.979839053087727*^9, 3.97983911476128*^9}, {
