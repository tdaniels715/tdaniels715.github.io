Cell[CellGroupData[{

Cell["Sign table printer (`sgnTable`)", "Subsection",
 CellChangeTimes->{{3.980866090375189*^9, 3.98086609651718*^9}, {
  3.980870817201846*^9, 3.9808708227038937`*^9}, {3.980870865217643*^9, 
