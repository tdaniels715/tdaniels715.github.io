Cell[CellGroupData[{

Cell["A \[OpenCurlyDoubleQuote]quirk\[CloseCurlyDoubleQuote] of series \
expansion", "Subsection",
 CellChangeTimes->{{3.979250387278076*^9, 3.979250411770405*^9}, {
   3.979250547329482*^9, 3.979250555029421*^9}, 3.980791848555019*^9, {
   3.980793557332399*^9, 
   3.98079355827064*^9}},ExpressionUUID->"c6779aab-0e58-4d41-9eb3-\
aa98f973d9f3"],

Cell[TextData[{
 "Mathematica sometimes has quirks when computing series expansions, in \
particular with what ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["q", "N"], ")"}], TraditionalForm]],ExpressionUUID->
  "7bc37c11-478c-4a7f-9457-939d01c8fc55"],
 " to \[OpenCurlyDoubleQuote]compute up to\[CloseCurlyDoubleQuote]. This can \
happen if\n\t1) There are negative powers in the Pochhammer symbols;\n\t2) \
The Pochhammer symbols are multiplied by powers ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["q", "M"], TraditionalForm]],ExpressionUUID->
  "b1554bae-fc9e-4b12-a23a-756c3916482c"],
 ";\nIn the example below, technically I request ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"O", "(", 
     SuperscriptBox["q", "500"], ")"}], ","}], TraditionalForm]],
  ExpressionUUID->"6d1f05ca-a8d2-4558-8fc5-678a5f1d8ab7"],
 " but we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", 
     SuperscriptBox["q", "583"]}], "+", 
    RowBox[{"O", "(", 
     SuperscriptBox["q", "584"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "62862d4b-d4a5-4568-8368-19365f651258"],
 ", which is part of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{"9", " ", 
     RowBox[{"(", 
      RowBox[{"mod", " ", "41"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "6833c538-c112-46d4-85b4-5e82bd062c95"],
 " component. Once we go higher than 583, things \
\[OpenCurlyDoubleQuote]settle\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.9792494232545547`*^9, 3.979249513309568*^9}, {
   3.9792496906163*^9, 3.9792498299547663`*^9}, 3.980791852858161*^9, {
   3.9807927796211433`*^9, 3.980792801637884*^9}, {3.98086556983893*^9, 
   3.9808655748778276`*^9}},ExpressionUUID->"47ea2af5-c7ed-423d-81b7-\
b61770d54205"],

