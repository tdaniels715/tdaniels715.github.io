Cell[CellGroupData[{

Cell["Sign computer (`CompSign`)", "Subsection",
 CellChangeTimes->{{3.980866212129434*^9, 3.9808662210727043`*^9}, {
  3.980870828244306*^9, 
  3.980870855748021*^9}},ExpressionUUID->"e9241c76-f932-4b10-ae03-\
bd33e4fd3cfe"],

Cell[TextData[{
 "The function `CompSign` computes the signs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "538c5f7f-e217-4d91-bd4d-056e07fbdf43"],
 " (or ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "33286edc-2192-4bee-aaac-2a560a3468f6"],
 ") as in Corollaries 5 and 8. \n\n",
 StyleBox["Note:",
  FontWeight->"Bold"],
 " The function requires that \[OpenCurlyDoubleQuote]global\
\[CloseCurlyDoubleQuote] variables ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65b4afeb-e20c-47af-bffe-607a48fde197"],
 ", ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6dd09644-57a1-40d8-b014-05908a7f8fa6"],
 ", ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f0bdeca8-a9ce-43bf-97d8-c01d1512f981"],
 ", ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b1741c7-2869-42b5-ad1b-0202cc2e3a07"],
 ", ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21c4e545-21e3-420e-82c8-8639d7f0c29b"],
 ", and ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f9e3b7b-7dc3-4ea1-a002-d39c43cef28a"],
 " be defined (as well as ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6038fa34-1afd-4e5c-a3eb-154dba39ddc4"],
 ", ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6100c900-e684-4ed8-91d5-6a3849e490bc"],
 ", etc.). Thus, to compute the sign of a particular ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c31c756-a7ec-4706-a8e0-6f0dbc9b6851"],
 "-component of a quintuple product, one should run (e.g.):\n\t",
 Cell[BoxData[
  FormBox[
   FormBox[
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"p", ",", "m", ",", "n", ",", "b", ",", "\[Mu]", ",", "s"}], 
       "]"}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "=", "13"}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"m", "=", "2"}], ";", 
      RowBox[{"n", "=", "3"}], ";", 
      RowBox[{"b", "=", "5"}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Mu]", "=", 
       RowBox[{"ModularInverse", "[", 
        RowBox[{
         RowBox[{"3", "m"}], ",", "p"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", "m", " ", "\[Mu]"}], "-", "1"}], ")"}], "/", "p"}]}], 
      ";"}]}],
    TraditionalForm], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "17feb872-e9ea-42e2-89dc-1d0e967d2117"],
 "\nto (re)set those values, and ",
 StyleBox["then",
  FontSlant->"Italic"],
 " run\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"CompSign", "[", "r", "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9b038c6-a2f9-401c-84e2-5ef695ee326f"]
}], "Text",
 CellChangeTimes->{{3.980867729088684*^9, 3.980867819092224*^9}, {
  3.980870405755234*^9, 3.980870409203944*^9}, {3.980870447360585*^9, 
  3.980870518936907*^9}, {3.98087091095826*^9, 
  3.98087091448177*^9}},ExpressionUUID->"109b0e06-b2fb-4fa3-a527-\
11151b049cbf"],

Cell[CellGroupData[{

Cell[TextData[{
 "Signs as in Corollary 5  ( ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[Congruent]", 
