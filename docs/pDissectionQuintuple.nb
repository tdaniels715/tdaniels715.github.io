  3.980876823609494*^9}},ExpressionUUID->"9d2b0380-6df0-412c-9d51-\
7d70ef4a1780"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", ",", "\[Sigma]", ",", 
    "\[Kappa]", ",", "\[Chi]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    OverscriptBox["\[Chi]", "~"], "=."}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Unset", " ", "definition"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{"3", "k", " ", "m", " ", "p"}], "+", 
    RowBox[{"3", "b", " ", "p"}], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "+", "n"}], ")"}], "p"}], "2"], "+", 
    FractionBox[
     RowBox[{"3", 
      SuperscriptBox["p", "2"]}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{"3", "k", " ", "n", " ", "p"}], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "-", "n"}], ")"}], "p"}], "2"], "+", 
    FractionBox[
     RowBox[{"3", 
      SuperscriptBox["p", "2"]}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]", "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{"3", "b", " ", "k", " ", "m"}], "+", 
    FractionBox[
     RowBox[{"k", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", "k"}], "-", "1"}], ")"}], "p"}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "k_", "]"}], ":=", 
   RowBox[{"k", 
    RowBox[{"(", 
     RowBox[{"k", "-", "1"}], ")"}], 
    FractionBox[
     RowBox[{"3", 
      SuperscriptBox["p", "2"]}], "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Kappa]", "[", "r_", "]"}], ":=", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"r", "*", 
       RowBox[{"ModularInverse", "[", 
        RowBox[{
         RowBox[{"3", "b", " ", "m"}], ",", "p"}], "]"}]}], ",", "p"}], 
     "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   Cell["k",ExpressionUUID->"93f2be5d-5c9f-4e21-a325-f784bb5b3010"], " ", 
    "such", " ", "that", " ", Cell[
    "3bkm \[Congruent] r (mod p)",ExpressionUUID->
     "42382db6-2632-49b6-b729-3c71242fbfd8"]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Gamma]", "[", "k", "]"}], " ", "+", " ", 
     RowBox[{"p", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"n", " ", "s"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k", " ", "n"}], "+", 
        FractionBox[
         RowBox[{"p", "+", "m", "-", 
          RowBox[{"n", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"p", " ", "s"}]}], ")"}]}]}], "6"]}], ")"}]}]}]}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Used", " ", "in", " ", "place", " ", "of", " ", 
    RowBox[{Cell[TextData[Cell[BoxData[
      FormBox[
       SubsuperscriptBox["\[Chi]", "k", "*"], TraditionalForm]],
      ExpressionUUID->"98b1afd3-6d66-4f45-bfaf-d72e1677aaba"]],ExpressionUUID->
      "2a0430f0-18f6-4bd4-9130-c2fbe5a5bc60"], ".", " ", "Entered"}], " ", 
    "using", " ", Cell[
    "\[EscapeKey]c\[EscapeKey] \[ControlKey]7 ~",ExpressionUUID->
     "459dc552-901f-4132-9843-29cfbc700c36"]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    OverscriptBox["\[Chi]", "~"], "[", "k_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Gamma]", "[", "k", "]"}], "+", 
    RowBox[{"p", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"m", " ", "s"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"b", "+", 
       RowBox[{"k", " ", "m"}], "+", 
       FractionBox[
        RowBox[{"p", "-", 
         RowBox[{"m", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"p", " ", "s"}]}], ")"}]}], "-", "n"}], "6"]}], 
      ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9792274927302313`*^9, 3.979227588829734*^9}, {
   3.9792278015897512`*^9, 3.979227802390376*^9}, {3.979228864561397*^9, 
   3.979228869232403*^9}, {3.979246459473711*^9, 3.979246471902294*^9}, {
   3.979246578882389*^9, 3.97924657901921*^9}, {3.9792508444858227`*^9, 
   3.979250880392627*^9}, {3.9792509157853127`*^9, 3.979250937786934*^9}, {
   3.979252088649189*^9, 3.979252123808375*^9}, {3.979857815687088*^9, 
   3.979857858887845*^9}, 3.979945585687854*^9, {3.9800219935885353`*^9, 
   3.980021994837002*^9}, {3.980023430251419*^9, 3.980023431409564*^9}, {
   3.980027988760524*^9, 3.980028054287586*^9}, {3.9801046822363653`*^9, 
