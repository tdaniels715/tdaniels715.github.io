Cell[CellGroupData[{

Cell["Matrix for GP/Pari", "Section",
 CellChangeTimes->{{3.95476663125222*^9, 
  3.954766633843439*^9}},ExpressionUUID->"e7832f04-62f5-4710-b776-\
175713e376a1"],

Cell[TextData[{
 "Want ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", 
    RowBox[{"6", "\[Cross]", "6"}]], TraditionalForm]],ExpressionUUID->
  "cc851ea0-1925-441a-a294-40992f024afe"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    RowBox[{"6", "\[Cross]", "1"}]], TraditionalForm]],ExpressionUUID->
  "e56ce0aa-a6fe-4a6f-b183-b9fe6c2adcb8"],
 " such that\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"M\:02bc", ":=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["M", 
         RowBox[{"6", "\[Cross]", "6"}]], 
        SubscriptBox["\[Mu]", 
         RowBox[{"6", "\[Cross]", "1"}]]},
       {
        SubscriptBox["0", 
         RowBox[{"1", "\[Cross]", "6"}]], "1"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b8e97948-4f04-448f-9ecb-93179418d567"],
 "\nsatisfies\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPhi]", "[", 
     RowBox[{"T\:02bc", ".", "M\:02bc", ".", "X\:02bc"}], "]"}], "=", 
    RowBox[{"\[CapitalPhi]", "[", 
     RowBox[{"T\:02bc", ".", "X\:02bc"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"4c663ad9-93c7-4763-b1a3-f8eabb9d53f0"],
 "\nExpanding this (a bit tedious) leads to the requirement that M (not M\
\:02bc) satisfies\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"J", ".", "T", ".", "M"}], ")"}], "\[Transpose]"}], ".", 
     RowBox[{"(", 
      RowBox[{"J", ".", "T", ".", "M"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"J", ".", "T"}], ")"}], "\[Transpose]"}], ".", 
     RowBox[{"(", 
      RowBox[{"J", ".", "T"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "7e30677e-906b-4887-9c64-7e64326b7592"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"M", "\[Transpose]"}], ".", 
     RowBox[{"T", "\[Transpose]"}], ".", 
     RowBox[{"J", "\[Transpose]"}], ".", "J", ".", "T", ".", "M"}], "=", 
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", 
     RowBox[{"J", "\[Transpose]"}], ".", "J", ".", "T"}]}], TraditionalForm]],
  ExpressionUUID->"59687f3c-e210-4e82-ae4c-80d2d6b1d493"],
 ".\nSo we compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"T", "\[Transpose]"}], ".", 
     RowBox[{"J", "\[Transpose]"}], ".", "J", ".", "T"}], " ", "=", " ", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"J", ".", "T"}], "\[RightAngleBracket]"}]}], TraditionalForm]],
  ExpressionUUID->"dec8ac7b-9b52-4436-b4c3-d76408a894bf"]
}], "Text",
 CellChangeTimes->{{3.9547666389586887`*^9, 
  3.954766910535849*^9}},ExpressionUUID->"5126173e-82a6-4cb6-b1b9-\
b2f98990fd71"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Qmat", "=", 
   RowBox[{
    RowBox[{"T", "\[Transpose]"}], ".", 
    RowBox[{"J", "\[Transpose]"}], ".", "J", ".", "T"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Qmat", "//", "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.954766918452591*^9, 3.9547669538107557`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"900c22e0-9eb3-4458-aaca-c81c5716ab19"],

