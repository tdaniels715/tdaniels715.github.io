       RowBox[{"Return", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{"x", ",", "m"}], "]"}], "-", "m"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{"x", ",", "m"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["md", "m_"], "[", "x_", "]"}], ":=", 
