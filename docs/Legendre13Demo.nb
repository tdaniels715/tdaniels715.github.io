  RowBox[{"(*", "\"\<Inner Product\>\"", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "\[LeftAngleBracket]", " ", "and", " ", "\[RightAngleBracket]"}], " ", 
      "entered", " ", 
      RowBox[{"using", " ", "[", "esc", "]"}]}], "<", 
