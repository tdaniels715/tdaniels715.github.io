Cell[TextData[{
 "Dihedral group generated by \n\t{r,s : ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "6"], "=", 
    RowBox[{
     SuperscriptBox["s", "2"], "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abd11e28-dfac-4c61-a6a2-6008d7979363"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", ".", "r"}], "=", 
    RowBox[{
     SuperscriptBox["r", 
      RowBox[{"-", "1"}]], ".", "s"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "77c201a1-c350-4b83-9b80-3ed37ad51e8d"],
 "}\nequivalently\n\t{",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", ",", 
    RowBox[{
     RowBox[{"s", ":", " ", 
      SuperscriptBox["r", "6"]}], "=", 
     RowBox[{
      SuperscriptBox["s", "2"], "=", 
      RowBox[{
       RowBox[{"s", ".", "r", ".", "s", ".", "r"}], "=", "1"}]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9dc1f913-7a7f-493f-8b24-1ff988d0ca05"],
 "}"
}], "Text",
