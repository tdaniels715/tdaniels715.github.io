      RowBox[{"x_", ",", "y_"}], "\[RightAngleBracket]"}], ":=", 
     RowBox[{
      RowBox[{"x", "\[Transpose]"}], ".", "y"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", "x_", "\[RightAngleBracket]"}], ":=", 
     RowBox[{
      RowBox[{"x", "\[Transpose]"}], ".", "x"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9547647292148247`*^9, 3.9547648102435637`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"d3a7d961-eeeb-4e07-bc00-8a29f1d7c2d6"],

Cell[BoxData[
